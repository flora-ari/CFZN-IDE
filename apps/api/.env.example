# PowerShell: $env:PORT = '3001'
PORT=3001
# If unset, uses the repository's .runtime/project-data directory.
# PROJECT_DATA_DIR=F:/CFZN/CFZN-IDE/.runtime/project-data
HARDWARE_PORT=3002
# Explicit operator-owned JSON file. Unset means all toolchain profiles unavailable.
# HARDWARE_CONFIG=F:/CFZN/CFZN-IDE/apps/api/hardware.config.example.json
# HARDWARE_RUNTIME_DIR=F:/CFZN/CFZN-IDE/.runtime/hardware
# HARDWARE_ALLOWED_ORIGINS=https://your-ide.example

# Maker integration requires Node.js 22.13+ (or Node.js 24) and is mandatory in production.
# Omit IDE_AUTH_MODE or use local for anonymous development storage.
# The MinIO bucket must already exist and be private. Set secrets in the service environment.
# IDE_AUTH_MODE=maker
# IDE_PUBLIC_ORIGIN=https://ide.xiaodaiyang.top
# IDE_PORTAL_ORIGIN=https://maker.xiaodaiyang.top
# IDE_MAKER_BASE_URL=http://127.0.0.1:8801
# IDE_MAKER_HOST=maker.xiaodaiyang.top
# IDE_SESSION_SECRET=
# IDE_MINIO_ENDPOINT=http://127.0.0.1:9000
# IDE_MINIO_BUCKET=
# IDE_MINIO_ACCESS_KEY=
# IDE_MINIO_SECRET_KEY=
# IDE_PROJECT_MAX_BYTES=67108864
# IDE_PROJECT_QUOTA_BYTES=1073741824
# IDE_PROJECT_MAX_COUNT=200
# IDE_SSO_TICKET_TTL=90
