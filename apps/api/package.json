{
  "name": "@cfzn-ide/api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.2" },
  "scripts": {
    "dev": "npm run build && concurrently -k -n compile,serve \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "hardware": "npm run build && npm run start:hardware",
    "start:hardware": "node dist/hardware-main.js",
    "test:hardware": "npm run build && node --test test/hardware*.test.cjs",
    "verify:hardware": "npm run build && node scripts/verify-hardware.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "serialport": "13.0.0",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "yazl": "^3.3.1"
  }
}
